# Icono de la app
          if [ -f app_icon.png ]; then
            mkdir -p app/android/app/src/main/res/mipmap-xxxhdpi
            mkdir -p app/android/app/src/main/res/mipmap-xxhdpi
            mkdir -p app/android/app/src/main/res/mipmap-xhdpi
            mkdir -p app/android/app/src/main/res/mipmap-hdpi
            mkdir -p app/android/app/src/main/res/mipmap-mdpi
            cp app_icon.png app/android/app/src/main/res/mipmap-xxxhdpi/ic_launcher.png
            cp app_icon.png app/android/app/src/main/res/mipmap-xxhdpi/ic_launcher.png
            cp app_icon.png app/android/app/src/main/res/mipmap-xhdpi/ic_launcher.png
            cp app_icon.png app/android/app/src/main/res/mipmap-hdpi/ic_launcher.png
            cp app_icon.png app/android/app/src/main/res/mipmap-mdpi/ic_launcher.png
            echo "Icono instalado"
          fi
